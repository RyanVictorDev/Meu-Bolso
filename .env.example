POSTGRES_DB=meubolso
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

SERVER_PORT=2030
DB_URL=jdbc:postgresql://db:5432/meubolso
DB_USER=postgres
DB_PASSWORD=change-this-postgres-password

# Use a unique random value with at least 64 characters before starting the stack.
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters-before-use
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_SEED_ADMIN_ENABLED=false
APP_SEED_ADMIN_NAME=Administrador
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

VITE_API_URL=http://localhost:2030
